name: Video Editor Workflow

on:
  workflow_dispatch: # يسمح لنا بتشغيله يدوياً بالضغط على زر

jobs:
  prepare-environment:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v3

      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.9'

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install requests
          pip install google-api-python-client google-auth-httplib2 google-auth-oauthlib
          pip install moviepy
          # moviepy هي مكتبة بديلة لـ FFmpeg أسهل في الاستخدام مع Python

      - name: Log success
        run: echo "Environment is ready! Python and dependencies are installed."
